{
	# 禁用 admin API（专用实例，只服务静态文件）
	admin off
	auto_https off
	email steven@aiflare.cloud
}

# 专用 Caddy 实例：仅监听 loopback，转发由主 Caddy 处理
:3000 {
	root * /home/ubuntu/apps/real-time-fund/out
	encode gzip zstd

	# 静态资源缓存（与原 nginx 配置一致）
	@assets {
		path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.wasm
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# 健康检查端点（总开关 API 用）
	handle /__health {
		respond "ok" 200
	}

	# 总开关控制端点（反代到 fund-switch-server 127.0.0.1:3010）
	# 前端路径 /__switch/{on,off,status} → 后端路径 /switch/{on,off} 或 /status
	@switchOn  path /__switch/on
	@switchOff path /__switch/off
	@switchStatus path /__switch/status

	handle @switchOn {
		rewrite * /switch/on
		reverse_proxy 127.0.0.1:3010 {
			header_up Host 127.0.0.1:3010
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle @switchOff {
		rewrite * /switch/off
		reverse_proxy 127.0.0.1:3010 {
			header_up Host 127.0.0.1:3010
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle @switchStatus {
		rewrite * /status
		reverse_proxy 127.0.0.1:3010 {
			header_up Host 127.0.0.1:3010
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 兜底：所有未匹配的请求走 file_server + try_files（SPA 路由）
	handle {
		try_files {path} {path}.html {path}/ /index.html
		file_server
	}
}